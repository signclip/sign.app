<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes into a cloud backup or onto another device (27.11., audit N4): the keys stay in the
     Android Keystore of this device anyway, what lies beside them would arrive without them. A new device joins anew. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
